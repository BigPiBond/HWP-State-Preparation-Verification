Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"isInvertibleByRank", "[", "mat_", "]"}], ":=", 
   RowBox[{
    RowBox[{"MatrixRank", "[", "mat", "]"}], "==", 
    RowBox[{
     RowBox[{"Dimensions", "[", "mat", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kra", "[", 
    RowBox[{"n_", ",", "k_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "i"}], "*", 
      RowBox[{"Binomial", "[", 
       RowBox[{"j", ",", "i"}], "]"}], "*", 
      RowBox[{"Binomial", "[", 
       RowBox[{
        RowBox[{"n", "-", "j"}], ",", 
        RowBox[{"k", "-", "i"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "k"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.978985854204935*^9, 3.9789858545388813`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"0f6f6a60-7fc0-7c4b-9369-0cf0d01462c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"n", "=", "201"}], ",", 
   RowBox[{"n", "<=", "300"}], ",", 
   RowBox[{"n", "=", 
    RowBox[{"n", "+", "1"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "n", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k1", "=", "1"}], ",", 
      RowBox[{"k1", "<", 
       RowBox[{"n", "/", "2"}]}], ",", 
      RowBox[{"k1", "=", 
       RowBox[{"k1", "+", "1"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k2", "=", "k1"}], ",", 
        RowBox[{"k2", "<=", 
         RowBox[{"n", "/", "2"}]}], ",", 
        RowBox[{"k2", "=", 
         RowBox[{"k2", "+", "1"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "n", ",", "\"\<,\>\"", ",", "k1", ",", "\"\<,\>\"", ",", "k2", 
            ",", "\"\< \>\""}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"f", "=", "0"}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"j", "=", "0"}], ",", 
            RowBox[{"j", "<=", "k2"}], ",", 
            RowBox[{"j", "=", 
             RowBox[{"j", "+", "1"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"A", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"2", "^", "j"}], "*", 
                 RowBox[{"kra", "[", 
                  RowBox[{
                   RowBox[{"n", "-", 
                    RowBox[{"2", "j"}]}], ",", 
                   RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"0", ",", 
                    RowBox[{"k1", "-", "j"}]}], "]"}], "+", "p", "-", "1"}], ",", 
                   RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"0", ",", 
                    RowBox[{"k1", "-", "j"}]}], "]"}], "+", "q", "-", "1"}]}],
                   "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"p", ",", 
                  RowBox[{"k2", "-", "j", "-", 
                   RowBox[{"Max", "[", 
                    RowBox[{"0", ",", 
                    RowBox[{"k1", "-", "j"}]}], "]"}], "+", "1"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"q", ",", 
                  RowBox[{"k2", "-", "j", "-", 
                   RowBox[{"Max", "[", 
                    RowBox[{"0", ",", 
                    RowBox[{"k1", "-", "j"}]}], "]"}], "+", "1"}]}], "}"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"isInvertibleByRank", "[", "A", "]"}], "==", 
                "False"}], ",", 
               RowBox[{"f", "=", "1"}]}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"f", "==", "1"}], ",", 
            RowBox[{"Print", "[", "\"\<False\>\"", "]"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
